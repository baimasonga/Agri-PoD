{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "AgriPod": "Server=(localdb)\\MSSQLLocalDB;Database=AgriPod;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "TwilioVerify": {
    "AccountSid": "",
    "AuthToken": "",
    "VerifyServiceSid": ""
  },
  "Jwt": {
    "Issuer": "AgriPod",
    "Audience": "AgriPod.Clients",
    "SigningKey": "development-only-signing-key-change-before-production"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7100",
      "http://localhost:5100"
    ]
  },
  "AllowedHosts": "*"
}
