<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=@DateTime.Now.Ticks" />
    <link rel="stylesheet" href="AgriPod.Blazor.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.agriPodCharts = {
            renderDoughnut: function (canvasId, data, labels) {
                const ctx = document.getElementById(canvasId);
                if (!ctx) return;
                if (window['chart_' + canvasId]) {
                    window['chart_' + canvasId].destroy();
                }
                window['chart_' + canvasId] = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: ['#ea580c', '#0369a1', '#8b5cf6', '#64748b'],
                            borderWidth: 0
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, cutout: '75%' }
                });
            },
            renderBar: function (canvasId, data, labels) {
                const ctx = document.getElementById(canvasId);
                if (!ctx) return;
                if (window['chart_' + canvasId]) {
                    window['chart_' + canvasId].destroy();
                }
                window['chart_' + canvasId] = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Count',
                            data: data,
                            backgroundColor: ['#be123c', '#ea580c', '#0369a1', '#15803d'],
                            borderWidth: 0,
                            borderRadius: 12
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
                });
            }
        };
    </script>
</body>

</html>
