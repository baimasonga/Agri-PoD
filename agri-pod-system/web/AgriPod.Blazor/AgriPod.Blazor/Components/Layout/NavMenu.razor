@inject PortalAuthState AuthState
@inject NavigationManager Navigation

<header class="header">
    <a class="brand" href="">
        <div class="brand-box">A</div>
        <span class="hud-title" style="font-size: 1.2rem;">Agri-PoD Core</span>
    </a>

    <nav class="nav-links">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Core</NavLink>
        <NavLink class="nav-item" href="farmers">Registry</NavLink>
        <NavLink class="nav-item" href="deliveries">PoD Ledger</NavLink>
        <NavLink class="nav-item" href="campaigns">Operations</NavLink>
        <NavLink class="nav-item" href="inventory">Logistics</NavLink>
        <NavLink class="nav-item" href="compliance">Security</NavLink>
        <NavLink class="nav-item" href="reports">Analytics</NavLink>
        <NavLink class="nav-item" href="administration">Admin</NavLink>
    </nav>

    <div style="display: flex; align-items: center; gap: 2rem;">
        <div style="text-align: right;">
            <div class="hud-title" style="font-size: 0.6rem; color: var(--primary);">@AuthState.Role</div>
            <div style="font-size: 0.75rem; color: var(--muted); font-weight: 500;">@AuthState.Email</div>
        </div>
        <button @onclick="SignOut" class="btn-danger" style="padding: 0.4rem 1.2rem; font-size: 0.6rem;">Abort</button>
    </div>
</header>

@code {
    private void SignOut()
    {
        AuthState.SignOut();
        Navigation.NavigateTo("/login");
    }
}
