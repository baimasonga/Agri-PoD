@inject PortalAuthState AuthState
@inject NavigationManager Navigation

<div class="brand">
    <div class="brand-icon">
        <span style="color: white; font-weight: 900;">AP</span>
    </div>
    <span>Agri-PoD <br/> <small style="font-size: 0.65rem; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.1em;">Terra Nova</small></span>
</div>

<nav class="nav-group">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <i>01</i>
        <span>Dashboard</span>
    </NavLink>
    
    <NavLink class="nav-link" href="reports">
        <i>02</i>
        <span>Analytics</span>
    </NavLink>

    <div style="height: 1rem;"></div>
    <span style="font-size: 0.65rem; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.15em; padding-left: 1.25rem; margin-bottom: 0.5rem; display: block;">Operations</span>

    @if (CanAccess("SystemAdministrator", "DistrictCoordinator", "FieldOfficer"))
    {
        <NavLink class="nav-link" href="farmers">
            <i>03</i>
            <span>Farmers</span>
        </NavLink>
    }

    @if (CanAccess("SystemAdministrator", "ProjectManager"))
    {
        <NavLink class="nav-link" href="campaigns">
            <i>04</i>
            <span>Campaigns</span>
        </NavLink>
    }

    @if (CanAccess("SystemAdministrator", "WarehouseManager"))
    {
        <NavLink class="nav-link" href="inventory">
            <i>05</i>
            <span>Inventory</span>
        </NavLink>
    }

    <div style="height: 1rem;"></div>
    <span style="font-size: 0.65rem; font-weight: 800; color: #475569; text-transform: uppercase; letter-spacing: 0.15em; padding-left: 1.25rem; margin-bottom: 0.5rem; display: block;">Compliance</span>

    <NavLink class="nav-link" href="compliance">
        <i>06</i>
        <span>Audit Logs</span>
    </NavLink>

    <div style="margin-top: auto;"></div>

    <NavLink class="nav-link" href="login" style="background: rgba(255,255,255,0.03); margin-top: 2rem;">
        <i>&rarr;</i>
        <span>Switch Role</span>
    </NavLink>
</nav>

@code {
    private bool IsLoginPage => new Uri(Navigation.Uri).AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase);

    private bool CanAccess(params string[] roles) =>
        AuthState.IsInRole(roles) || (!AuthState.IsAuthenticated && !IsLoginPage);
}
