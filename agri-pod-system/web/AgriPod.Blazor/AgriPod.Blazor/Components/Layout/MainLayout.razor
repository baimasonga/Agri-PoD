@inherits LayoutComponentBase
@inject PortalAuthState AuthState
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
            <div>
                <span style="font-size: 0.85rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em;">Agri-PoD Command Center</span>
            </div>
            <div style="display: flex; align-items: center; gap: 1.5rem;">
                <div style="text-align: right;">
                    <div style="font-weight: 700; font-size: 0.9rem;">@(AuthState.IsAuthenticated ? AuthState.Email : "Guest Session")</div>
                    <div style="font-size: 0.75rem; color: var(--muted); font-weight: 600;">@(AuthState.IsAuthenticated ? AuthState.Role : "Public Access")</div>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem; color: #64748b;">
                    @(AuthState.IsAuthenticated ? AuthState.Email[0].ToString().ToUpper() : "?")
                </div>
            </div>
        </header>

        <article>
            @if (!AuthState.IsAuthenticated && !IsLoginPage)
            {
                <div class="terra-card" style="max-width: 500px; margin: 5rem auto; text-align: center;">
                    <h2 style="font-size: 2rem; margin-bottom: 1rem;">Welcome to Agri-PoD</h2>
                    <p style="margin-bottom: 2rem;">Please authenticate to access the national distribution dashboard and operational controls.</p>
                    <button type="button" @onclick="SignIn" style="width: 100%;">Sign in to Portal</button>
                </div>
            }
            else
            {
                @Body
            }
        </article>
    </main>
</div>

@code {
    private bool IsLoginPage => new Uri(Navigation.Uri).AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated && !IsLoginPage)
        {
            await SignInAsDemoAdmin();
        }
    }

    private void SignIn() => Navigation.NavigateTo("/login");

    private async Task SignInAsDemoAdmin()
    {
        try 
        {
            var client = HttpClientFactory.CreateClient("AgriPodApi");
            var response = await client.PostAsJsonAsync("/api/v1/auth/login", new AgriPod.Shared.LoginRequest("admin@agripod.local", "demo"));
            if (response.IsSuccessStatusCode)
            {
                var token = await response.Content.ReadFromJsonAsync<AgriPod.Shared.AuthTokenResponse>();
                if (token is not null)
                {
                    AuthState.SignIn("admin@agripod.local", token.Role, token.AccessToken, token.ExpiresAt);
                }
            }
        }
        catch { /* API might be down during build */ }
    }
}
