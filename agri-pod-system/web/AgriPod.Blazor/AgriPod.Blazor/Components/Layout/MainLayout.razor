@inherits LayoutComponentBase
@inject PortalAuthState AuthState
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div>
                <strong>National command portal</strong>
                <span>@(AuthState.IsAuthenticated ? $"{AuthState.Email} - {AuthState.Role}" : "Sign in required")</span>
            </div>
            @if (AuthState.IsAuthenticated)
            {
                <button class="sync-button" type="button" @onclick="SignOut">Sign out</button>
            }
            else
            {
                <button class="sync-button" type="button" @onclick="SignIn">Sign in</button>
            }
        </div>

        <article class="content">
            @if (!AuthState.IsAuthenticated && !IsLoginPage)
            {
                <section class="login-panel">
                    <h1>Sign in required</h1>
                    <p>Use a seeded demo role to access Agri-PoD workflows.</p>
                    <button type="button" @onclick="SignIn">Go to login</button>
                </section>
            }
            else
            {
                @Body
            }
        </article>
    </main>
</div>

@code {
    private bool IsLoginPage => new Uri(Navigation.Uri).AbsolutePath.Equals("/login", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated && !IsLoginPage)
        {
            await SignInAsDemoAdmin();
        }
    }

    private void SignOut()
    {
        AuthState.SignOut();
        Navigation.NavigateTo("/login");
    }

    private void SignIn() => Navigation.NavigateTo("/login");

    private async Task SignInAsDemoAdmin()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        var response = await client.PostAsJsonAsync("/api/v1/auth/login", new AgriPod.Shared.LoginRequest("admin@agripod.local", "demo"));
        if (!response.IsSuccessStatusCode)
        {
            return;
        }

        var token = await response.Content.ReadFromJsonAsync<AgriPod.Shared.AuthTokenResponse>();
        if (token is null)
        {
            return;
        }

        AuthState.SignIn("admin@agripod.local", token.Role, token.AccessToken, token.ExpiresAt);
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">x</a>
</div>
