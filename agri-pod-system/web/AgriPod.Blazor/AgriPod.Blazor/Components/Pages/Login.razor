@page "/login"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory
@inject PortalAuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Obsidian Field | Authorization</PageTitle>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at center, #111 0%, #000 100%);
    }
    .auth-card {
        width: 100%;
        max-width: 500px;
        padding: 3rem;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: 0 0 50px rgba(0,0,0,0.5);
    }
    .role-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        margin-top: 2rem;
    }
    .role-btn {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--muted);
        padding: 0.75rem;
        font-size: 0.65rem;
        font-weight: 900;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .role-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(16, 185, 129, 0.05);
    }
</style>

<div class="login-container">
    <div class="auth-card">
        <div style="margin-bottom: 2rem; text-align: center;">
            <div style="font-size: 2rem; font-weight: 900; color: var(--primary); letter-spacing: -0.05em; margin-bottom: 0.5rem;">AGRI-POD</div>
            <div style="font-size: 0.7rem; font-weight: 800; color: var(--muted); letter-spacing: 0.3em; text-transform: uppercase;">Obsidian Field Ops</div>
        </div>

        <div class="hud-input-group">
            <label>IDENTIFIER</label>
            <input @bind="_email" placeholder="email@agripod.local" />
        </div>
        <div class="hud-input-group">
            <label>ACCESS KEY</label>
            <input type="password" @bind="_password" />
        </div>

        <button style="width: 100%; height: 3.5rem; margin-top: 1rem;" @onclick="SignIn">Authorize Access</button>

        <div style="margin-top: 3rem;">
            <div style="font-size: 0.6rem; font-weight: 900; color: var(--muted); margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">SIMULATE CLEARANCE LEVEL</div>
            <div class="role-grid">
                @foreach (var account in DemoAccounts)
                {
                    <button class="role-btn" @onclick="() => SignInAs(account.Email)">@account.Label</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div style="margin-top: 2rem; padding: 1rem; border: 1px solid var(--accent); color: var(--accent); font-size: 0.7rem; font-weight: 900; text-transform: uppercase;">
                [AUTH ERROR]: @_message
            </div>
        }
    </div>
</div>

@code {
    private string _email = "admin@agripod.local";
    private string _password = "demo";
    private string? _message;

    private static readonly DemoAccount[] DemoAccounts =
    [
        new("System Admin", "admin@agripod.local"),
        new("Project Manager", "manager@agripod.local"),
        new("Procurement", "procurement@agripod.local"),
        new("Warehouse", "warehouse@agripod.local"),
        new("Coordinator", "coordinator@agripod.local"),
        new("Field Officer", "field@agripod.local"),
        new("Driver", "driver@agripod.local"),
        new("Monitoring", "me@agripod.local"),
        new("Auditor", "audit@agripod.local"),
        new("Viewer", "viewer@agripod.local")
    ];

    private async Task SignInAs(string email)
    {
        _email = email;
        _password = "demo";
        await SignIn();
    }

    private async Task SignIn()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        var response = await client.PostAsJsonAsync("/api/v1/auth/login", new LoginRequest(_email, _password));
        if (!response.IsSuccessStatusCode)
        {
            _message = "Invalid Credentials";
            return;
        }

        var token = await response.Content.ReadFromJsonAsync<AuthTokenResponse>();
        if (token is null) return;

        AuthState.SignIn(_email, token.Role, token.AccessToken, token.ExpiresAt);
        Navigation.NavigateTo("/");
    }

    private sealed record DemoAccount(string Label, string Email);
}
