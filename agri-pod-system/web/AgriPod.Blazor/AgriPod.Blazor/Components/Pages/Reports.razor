@page "/reports"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<PageTitle>Obsidian Field | Analytics</PageTitle>

<div style="margin-bottom: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">Analytics Core</h1>
    <p style="color: var(--muted); font-weight: 700; letter-spacing: 0.1em;">Monitoring & Evaluation | National Performance Metrology</p>
</div>

<div class="metric-row">
    <div class="hud-panel metric-widget">
        <span class="metric-label">Approved Beneficiaries</span>
        <div class="metric-value">@_summary.FarmersApproved</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--primary); font-weight: 800;">REGISTRY: VERIFIED</div>
    </div>
    
    <div class="hud-panel metric-widget" style="border-color: var(--secondary);">
        <span class="metric-label">Closed Distributions</span>
        <div class="metric-value" style="color: var(--secondary);">@_summary.DeliveriesCompleted</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--secondary); font-weight: 800;">POD: CONFIRMED</div>
    </div>

    <div class="hud-panel metric-widget" style="border-color: var(--accent);">
        <span class="metric-label">Pending Syncs</span>
        <div class="metric-value" style="color: var(--accent);">@_summary.OfflineMutationsPending</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--accent); font-weight: 800;">MOBILE: DATA QUEUED</div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
    <div class="hud-panel" style="height: 400px; display: flex; flex-direction: column;">
        <h2 class="hud-title" style="font-size: 1rem; margin-bottom: 2rem;">Distribution Velocity</h2>
        <div style="flex: 1; position: relative;">
            <canvas id="progressChart"></canvas>
        </div>
    </div>
    <div class="hud-panel" style="height: 400px; display: flex; flex-direction: column;">
        <h2 class="hud-title" style="font-size: 1rem; margin-bottom: 2rem; color: var(--accent);">Integrity Health</h2>
        <div style="flex: 1; position: relative;">
            <canvas id="healthChart"></canvas>
        </div>
    </div>
</div>

<div class="hud-panel">
    <h2 class="hud-title" style="font-size: 1.2rem; margin-bottom: 3rem;">Operational Intelligence Catalogue</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        @foreach (var report in ReportCatalogue)
        {
            <div style="padding: 1.5rem; border: 1px solid var(--border); background: rgba(255,255,255,0.02);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h3 class="hud-title" style="font-size: 0.75rem; margin: 0; color: var(--primary);">@report.Name</h3>
                    <span style="font-size: 0.6rem; font-weight: 900; color: var(--muted);">@report.Status</span>
                </div>
                <p style="font-size: 0.75rem; color: var(--muted); margin: 0;">@report.Description</p>
                <button class="btn-secondary" style="width: 100%; margin-top: 1.5rem; height: 2.5rem; font-size: 0.6rem;">Generate Uplink</button>
            </div>
        }
    </div>
</div>

@code {
    private ReportSummaryDto _summary = new(0, 0, 0, 0, 0, 0);
    private static readonly ReportRow[] ReportCatalogue =
    [
        new("Farmer coverage", "Geospatial distribution across districts and chiefdoms.", "Ready"),
        new("Logistics trail", "Batch traceability and warehouse depletion metrics.", "Ready"),
        new("Biometric audit", "Facial recognition match rates and MFA bypass logs.", "Ready"),
        new("Geofence analysis", "Distribution mapping and boundary breach exceptions.", "Ready"),
        new("Sync latency", "Time-to-cloud metrics for offline field transactions.", "Ready"),
        new("Audit velocity", "Actor-event frequency and system throughput analysis.", "Ready")
    ];

    protected override async Task OnInitializedAsync() => await Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await RenderCharts(); }
    }

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        _summary = await client.GetFromJsonAsync<ReportSummaryDto>("/api/v1/reports/summary") ?? new(0, 0, 0, 0, 0, 0);
        await RenderCharts();
    }

    private async Task RenderCharts()
    {
        try {
            var progressData = new[] { _summary.FarmersApproved, _summary.DeliveriesCompleted, _summary.CampaignsActive };
            var progressLabels = new[] { "Approved", "Delivered", "Campaigns" };
            await JSRuntime.InvokeVoidAsync("agriPodCharts.renderDoughnut", "progressChart", progressData, progressLabels);

            var healthData = new[] { _summary.OpenExceptions, _summary.OfflineMutationsPending };
            var healthLabels = new[] { "Exceptions", "Pending Syncs" };
            await JSRuntime.InvokeVoidAsync("agriPodCharts.renderBar", "healthChart", healthData, healthLabels);
        } catch { }
    }

    private sealed record ReportRow(string Name, string Description, string Status);
}
