@page "/procurement"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Procurement</PageTitle>

<section class="page-section">
    <h1>Procurement and stock receiving</h1>
    <p>Purchased inputs are registered by supplier, quantity, batch, quality checks, expiry, and package barcode generation.</p>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <section class="notice">@_message</section>
}

<section class="workbench">
    <div class="panel large-panel">
        <div class="panel-header"><h2>Live purchase orders</h2><button type="button" @onclick="Load">Refresh</button></div>
        <table>
            <thead><tr><th>PO</th><th>Supplier</th><th>Item</th><th>Quantity</th><th>Batch</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var po in _orders)
                {
                    <tr><td>@po.PurchaseNumber</td><td>@SupplierName(po.SupplierId)</td><td>@ItemName(po.InventoryItemId)</td><td>@po.Quantity.ToString("N0")</td><td>@po.BatchNumber</td><td><span class="state ok">Submitted</span></td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="panel">
        <h2>Create supplier</h2>
        <form class="form-stack" method="post" action="/portal-actions/procurement/create-supplier">
            <label>Name <input name="name" @bind="_supplier.Name" /></label>
            <label>Phone <input name="phone" @bind="_supplier.Phone" /></label>
            <button type="submit">Create supplier</button>
        </form>
    </div>
</section>

<section class="workbench">
    <div class="panel">
        <div class="panel-header compact">
            <div>
                <h2>Create purchase order</h2>
                <p>Procurement officer submits purchased inputs for warehouse receipt.</p>
            </div>
        </div>
        <form class="form-stack" method="post" action="/portal-actions/procurement/create-purchase-order">
            <label>Purchase number <input name="purchaseNumber" value="@($"PO-{DateTime.Today:yyyy}-{Random.Shared.Next(100,999)}")" /></label>
            <label>
                Supplier
                <select name="supplierId">
                    @foreach (var supplier in _suppliers)
                    {
                        <option value="@supplier.Id">@supplier.Name</option>
                    }
                </select>
            </label>
            <label>
                Input item
                <select name="inventoryItemId">
                    @foreach (var item in _items)
                    {
                        <option value="@item.Id">@item.Name (@item.Sku)</option>
                    }
                </select>
            </label>
            <label>Quantity <input name="quantity" value="2500" /></label>
            <label>Batch number <input name="batchNumber" value="@($"BT-{Random.Shared.Next(1000,9999)}")" /></label>
            <button type="submit">Create purchase order</button>
        </form>
    </div>
    <div class="panel">
        <div class="panel-header compact">
            <div>
                <h2>Receive stock</h2>
                <p>Warehouse receipt creates traceable stock lots for package barcode generation.</p>
            </div>
        </div>
        <form class="form-stack" method="post" action="/portal-actions/procurement/receive-stock">
            <label>
                Input item
                <select name="inventoryItemId">
                    @foreach (var item in _items)
                    {
                        <option value="@item.Id">@item.Name (@item.UnitOfMeasure)</option>
                    }
                </select>
            </label>
            <label>
                Warehouse
                <select name="warehouseId">
                    @foreach (var warehouse in _warehouses)
                    {
                        <option value="@warehouse.Id">@warehouse.Name - @warehouse.District</option>
                    }
                </select>
            </label>
            <label>Lot code <input name="lotCode" value="@($"LOT-{DateTime.Today:MMdd}-{Random.Shared.Next(100,999)}")" /></label>
            <label>Quantity <input name="quantity" value="1200" /></label>
            <label>Expiry <input name="expiresOn" type="date" value="@DateTime.Today.AddMonths(18).ToString("yyyy-MM-dd")" /></label>
            <button type="submit">Receive stock</button>
        </form>
    </div>
</section>

<section class="panel">
    <div class="panel-header compact">
        <h2>Supplier directory</h2>
        <span class="state sync">@_suppliers.Count suppliers</span>
    </div>
    <div class="flow-strip">
        @foreach (var supplier in _suppliers)
        {
            <span>@supplier.Name</span>
        }
    </div>
</section>

@code {
    private readonly List<SupplierDto> _suppliers = [];
    private readonly List<PurchaseOrderDto> _orders = [];
    private readonly List<InventoryItemDto> _items = [];
    private readonly List<WarehouseDto> _warehouses = [];
    private string? _message;
    private SupplierForm _supplier = SupplierForm.Default();

    protected override async Task OnInitializedAsync()
    {
        _message = QueryMessage();
        await Load();
    }

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        _suppliers.Clear(); _orders.Clear(); _items.Clear(); _warehouses.Clear();
        _suppliers.AddRange(await client.GetFromJsonAsync<List<SupplierDto>>("/api/v1/procurement/suppliers") ?? []);
        _orders.AddRange(await client.GetFromJsonAsync<List<PurchaseOrderDto>>("/api/v1/procurement/purchase-orders") ?? []);
        _items.AddRange(await client.GetFromJsonAsync<List<InventoryItemDto>>("/api/v1/inventory-items") ?? []);
        _warehouses.AddRange(await client.GetFromJsonAsync<List<WarehouseDto>>("/api/v1/warehouses") ?? []);
    }

    private async Task CreateSupplier()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("AgriPodApi");
            var response = await client.PostAsJsonAsync("/api/v1/procurement/suppliers", new CreateSupplierRequest(_supplier.Name, _supplier.Phone));
            if (!response.IsSuccessStatusCode)
            {
                _message = $"Create supplier failed: {response.StatusCode}";
                return;
            }

            _message = $"Created supplier {_supplier.Name}.";
            _supplier = SupplierForm.Default();
            await Load();
        }
        catch (Exception ex)
        {
            _message = $"Create supplier failed: {ex.Message}";
        }
    }

    private string SupplierName(Guid id) => _suppliers.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString("N")[..8];
    private string ItemName(Guid id) => _items.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString("N")[..8];

    private sealed class SupplierForm
    {
        public string Name { get; set; } = "";
        public string Phone { get; set; } = "";
        public static SupplierForm Default() => new() { Name = $"Supplier {Random.Shared.Next(100,999)}", Phone = "+23276002001" };
    }

    private string? QueryMessage()
    {
        var query = new Uri(Navigation.Uri).Query;
        const string key = "?message=";
        return query.StartsWith(key, StringComparison.OrdinalIgnoreCase) ? Uri.UnescapeDataString(query[key.Length..]) : null;
    }
}
