@page "/farmers"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Farmer Management</PageTitle>

<div class="dashboard-header">
    <h1>Farmer Registry</h1>
    <p class="subtitle">National database of registered beneficiaries and eligibility review queue.</p>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="terra-card" style="background: var(--primary); color: white; padding: 1rem; margin-bottom: 2rem;">
        <strong>Notice:</strong> @_message
    </div>
}

<div style="display: grid; grid-template-columns: 1fr 350px; gap: 3rem; align-items: start;">
    <div class="data-surface">
        <div style="padding: 2rem; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;">
            <h2 style="margin: 0;">Approval Queue</h2>
            <button class="secondary-button" @onclick="LoadFarmers">Refresh List</button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Beneficiary</th>
                    <th>Region</th>
                    <th>Value Chain</th>
                    <th>Status</th>
                    <th style="text-align: right;">Management</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var farmer in _farmers)
                {
                    <tr>
                        <td>
                            <div style="font-weight: 700; color: var(--ink);">@farmer.FullName</div>
                            <div style="font-size: 0.75rem; color: var(--muted);">@farmer.BarcodeToken</div>
                        </td>
                        <td>@farmer.DistrictCode</td>
                        <td><span style="font-size: 0.8rem; font-weight: 600; padding: 0.25rem 0.75rem; background: #f1f5f9; border-radius: 4px;">@farmer.ValueChain</span></td>
                        <td><span class="badge @StatusClass(farmer.Status)">@farmer.Status</span></td>
                        <td style="text-align: right;">
                            @if (farmer.Status == "PendingReview")
                            {
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <button type="button" @onclick="() => ReviewFarmer(farmer.Id, true)" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">Approve</button>
                                    <button class="secondary-button" type="button" @onclick="() => ReviewFarmer(farmer.Id, false)" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">Reject</button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="terra-card">
        <h2 style="margin-bottom: 1.5rem;">Quick Registration</h2>
        <div class="form-stack">
            <div class="form-group">
                <label>Full Name</label>
                <input @bind="_newFarmer.FullName" placeholder="e.g. John Kamara" />
            </div>
            <div class="form-group">
                <label>National ID</label>
                <input @bind="_newFarmer.NationalId" placeholder="SL-XXX-XXX" />
            </div>
            <div class="form-group">
                <label>Phone Number</label>
                <input @bind="_newFarmer.Phone" placeholder="+232..." />
            </div>
            <div class="form-group">
                <label>District</label>
                <input @bind="_newFarmer.DistrictCode" placeholder="BOMBALI" />
            </div>
            <button type="button" @onclick="RegisterFarmer" style="width: 100%; margin-top: 1rem;">Create Beneficiary</button>
        </div>
    </div>
</div>

@code {
    private readonly List<FarmerDto> _farmers = [];
    private string? _message;
    private FarmerForm _newFarmer = FarmerForm.Default();

    protected override async Task OnInitializedAsync()
    {
        await LoadFarmers();
    }

    private async Task LoadFarmers()
    {
        try {
            var client = HttpClientFactory.CreateClient("AgriPodApi");
            var farmers = await client.GetFromJsonAsync<List<FarmerDto>>("/api/v1/farmers") ?? [];
            _farmers.Clear();
            _farmers.AddRange(farmers);
        } catch (Exception ex) {
            _message = $"Load failed: {ex.Message}";
        }
    }

    private async Task RegisterFarmer()
    {
        var request = new RegisterFarmerRequest(
            _newFarmer.FullName, _newFarmer.NationalId, _newFarmer.Phone,
            _newFarmer.DistrictCode, "Chiefdom", "Community", "Rice",
            8.889m, -12.044m, "img_reference");

        var client = HttpClientFactory.CreateClient("AgriPodApi");
        var response = await client.PostAsJsonAsync("/api/v1/farmers", request);
        _message = response.IsSuccessStatusCode ? "Beneficiary created." : "Registration failed.";
        await LoadFarmers();
    }

    private async Task ReviewFarmer(Guid farmerId, bool approved)
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        await client.PostAsJsonAsync($"/api/v1/farmers/{farmerId}/review", new ReviewFarmerRequest(approved, "Reviewed in portal"));
        await LoadFarmers();
    }

    private static string StatusClass(string status) => status switch
    {
        "Approved" => "badge-success",
        "Rejected" => "badge-danger",
        "PendingReview" => "badge-warning",
        _ => "badge-warning"
    };

    private sealed class FarmerForm
    {
        public string FullName { get; set; } = "";
        public string NationalId { get; set; } = "";
        public string Phone { get; set; } = "";
        public string DistrictCode { get; set; } = "";
        public static FarmerForm Default() => new() { FullName = "", NationalId = "", Phone = "", DistrictCode = "BOMBALI" };
    }
}
