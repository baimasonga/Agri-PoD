@page "/inventory"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Inventory</PageTitle>

<section class="page-section">
    <h1>Inventory</h1>
    <p>Stock lots are backed by the live API and ready for Azure SQL online storage, SQL Server Express district replicas, and SQLite mobile reads.</p>
</section>

<section class="metric-grid">
    <div class="metric-card"><span>Items</span><strong>@_items.Count</strong><p>registered agricultural inputs</p></div>
    <div class="metric-card"><span>Warehouses</span><strong>@_warehouses.Count</strong><p>national and district stores</p></div>
    <div class="metric-card"><span>Stock lots</span><strong>@_lots.Count</strong><p>batches with traceability</p></div>
    <div class="metric-card warning"><span>Total quantity</span><strong>@_lots.Sum(x => x.Quantity).ToString("N0")</strong><p>all tracked units</p></div>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <section class="notice">@_message</section>
}

<section class="workbench">
    <div class="panel large-panel">
        <div class="panel-header"><h2>Live stock lots</h2><button type="button" @onclick="Load">Refresh</button></div>
        <table>
            <thead><tr><th>Lot</th><th>Warehouse</th><th>Item</th><th>Quantity</th><th>Expiry</th></tr></thead>
            <tbody>
                @foreach (var lot in _lots)
                {
                    <tr><td>@lot.LotCode</td><td>@lot.WarehouseCode</td><td>@ItemName(lot.ItemId)</td><td>@lot.Quantity.ToString("N0")</td><td>@(lot.ExpiresOn?.ToString("yyyy-MM-dd") ?? "None")</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="panel">
        <h2>Create item</h2>
        <form class="form-stack" method="post" action="/portal-actions/inventory/create-item">
            <label>SKU <input name="sku" @bind="_item.Sku" /></label>
            <label>Name <input name="name" @bind="_item.Name" /></label>
            <label>Category <input name="category" @bind="_item.Category" /></label>
            <label>Unit <input name="unitOfMeasure" @bind="_item.UnitOfMeasure" /></label>
            <button type="submit">Create item</button>
        </form>
    </div>
</section>

@code {
    private readonly List<InventoryItemDto> _items = [];
    private readonly List<WarehouseDto> _warehouses = [];
    private readonly List<StockLotDto> _lots = [];
    private string? _message;
    private ItemForm _item = ItemForm.Default();

    protected override async Task OnInitializedAsync()
    {
        _message = QueryMessage();
        await Load();
    }

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        _items.Clear(); _warehouses.Clear(); _lots.Clear();
        _items.AddRange(await client.GetFromJsonAsync<List<InventoryItemDto>>("/api/v1/inventory-items") ?? []);
        _warehouses.AddRange(await client.GetFromJsonAsync<List<WarehouseDto>>("/api/v1/warehouses") ?? []);
        _lots.AddRange(await client.GetFromJsonAsync<List<StockLotDto>>("/api/v1/stock-lots") ?? []);
    }

    private async Task CreateItem()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("AgriPodApi");
            var response = await client.PostAsJsonAsync("/api/v1/inventory-items", new CreateInventoryItemRequest(_item.Sku, _item.Name, _item.Category, _item.UnitOfMeasure));
            if (!response.IsSuccessStatusCode)
            {
                _message = $"Create item failed: {response.StatusCode}";
                return;
            }

            _message = $"Created item {_item.Sku}.";
            _item = ItemForm.Default();
            await Load();
        }
        catch (Exception ex)
        {
            _message = $"Create item failed: {ex.Message}";
        }
    }

    private string ItemName(Guid id) => _items.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString("N")[..8];

    private sealed class ItemForm
    {
        public string Sku { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public string UnitOfMeasure { get; set; } = "";
        public static ItemForm Default() => new() { Sku = $"INPUT-{Random.Shared.Next(100,999)}", Name = "Demo input", Category = "Seed", UnitOfMeasure = "kg" };
    }

    private string? QueryMessage()
    {
        var query = new Uri(Navigation.Uri).Query;
        const string key = "?message=";
        return query.StartsWith(key, StringComparison.OrdinalIgnoreCase) ? Uri.UnescapeDataString(query[key.Length..]) : null;
    }
}
