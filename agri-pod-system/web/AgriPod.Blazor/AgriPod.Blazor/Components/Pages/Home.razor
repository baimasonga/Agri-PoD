@page "/"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Obsidian Field | Command Console</PageTitle>

<div style="margin-bottom: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">System Core</h1>
    <p style="color: var(--muted); font-weight: 700; letter-spacing: 0.1em;">National Distribution Hub | Sierra Leone</p>
</div>

<div class="metric-row">
    <div class="hud-panel metric-widget">
        <span class="metric-label">Beneficiary Nodes</span>
        <div class="metric-value">@_summary.FarmersRegistered</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--primary); font-weight: 800; letter-spacing: 0.1em;">DATA UPLINK: ACTIVE</div>
    </div>
    
    <div class="hud-panel metric-widget" style="border-color: var(--secondary);">
        <span class="metric-label">Operational Hubs</span>
        <div class="metric-value" style="color: var(--secondary); text-shadow: 0 0 20px rgba(59, 130, 246, 0.3);">@_summary.CampaignsActive</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--secondary); font-weight: 800; letter-spacing: 0.1em;">SYNC STATUS: NOMINAL</div>
    </div>

    <div class="hud-panel metric-widget" style="border-color: var(--accent);">
        <span class="metric-label">Anomaly Count</span>
        <div class="metric-value" style="color: var(--accent); text-shadow: 0 0 20px rgba(244, 63, 94, 0.3);">@_summary.OpenExceptions</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--accent); font-weight: 800; letter-spacing: 0.1em;">THREAT LEVEL: HIGH</div>
    </div>
</div>

<div class="hud-panel">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
        <h2 class="hud-title" style="margin: 0; font-size: 1.5rem;">Evidence Stream</h2>
        <button style="border-radius: 0;">Scan All Nodes</button>
    </div>

    <div class="tech-table-container">
        <table>
            <thead>
                <tr>
                    <th>UUID</th>
                    <th>ZONE</th>
                    <th>DESTINATION</th>
                    <th>EVIDENCE</th>
                    <th>INTEGRITY</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var delivery in Deliveries)
                {
                    <tr>
                        <td style="font-weight: 900; color: var(--primary);">@delivery.Number</td>
                        <td style="font-weight: 700;">@delivery.District</td>
                        <td>@delivery.Recipient</td>
                        <td>
                            <span style="font-family: monospace; font-size: 0.75rem; color: var(--secondary);">0x@(delivery.Number.GetHashCode().ToString("X"))</span>
                        </td>
                        <td>
                            <span class="dot" style="color: @(delivery.StateClass == "ok" ? "var(--primary)" : "var(--accent)"); background: currentColor;"></span>
                            <span style="font-size: 0.7rem; font-weight: 900; color: @(delivery.StateClass == "ok" ? "var(--primary)" : "var(--accent)");">
                                @delivery.State.ToUpper()
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private ReportSummaryDto _summary = new(0, 0, 0, 0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        try {
            var client = HttpClientFactory.CreateClient("AgriPodApi");
            _summary = await client.GetFromJsonAsync<ReportSummaryDto>("/api/v1/reports/summary") ?? _summary;
        } catch {}
    }

    private static readonly DeliveryRow[] Deliveries =
    [
        new("TRK-8821-X", "Bombali", "Union Hub 01", "Verified", "Verified", "ok"),
        new("TRK-8824-Y", "Bo", "Tikonko Node", "Pending", "Processing", "warn"),
        new("TRK-8827-Z", "Kono", "Gbense Alpha", "Verified", "Verified", "ok")
    ];

    private sealed record DeliveryRow(string Number, string District, string Recipient, string Proof, string State, string StateClass);
}
