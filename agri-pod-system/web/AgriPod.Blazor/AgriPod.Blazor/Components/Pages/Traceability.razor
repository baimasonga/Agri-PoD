@page "/traceability"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Traceability</PageTitle>

<section class="page-section">
    <div>
        <h1>Traceability and reconciliation</h1>
        <p>Generate secure barcode tokens, review package accountability, and submit stock reconciliation reports.</p>
    </div>
    <div class="status-strip">
        <span>Farmer QR</span>
        <span>Package barcode</span>
        <span>Manifest barcode</span>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <section class="notice">@_message</section>
}

<section class="workbench">
    <div class="panel large-panel">
        <div class="panel-header">
            <div>
                <h2>Campaign reconciliation preview</h2>
                <p>Compares allocated or loaded quantity, delivered quantity, returned stock, and discrepancies.</p>
            </div>
            <button type="button" @onclick="Load">Refresh</button>
        </div>
        <table>
            <thead><tr><th>Campaign</th><th>Status</th><th>Allocated</th><th>Delivered</th><th>Discrepancy</th></tr></thead>
            <tbody>
                @foreach (var row in _reconciliations)
                {
                    <tr>
                        <td>@row.CampaignName</td>
                        <td><span class="state @StatusClass(row.Status)">@row.Status</span></td>
                        <td>@row.LoadedQuantity.ToString("N0")</td>
                        <td>@row.DeliveredQuantity.ToString("N0")</td>
                        <td>@row.DiscrepancyQuantity.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="panel">
        <h2>Generate barcode token</h2>
        <form class="form-stack" method="post" action="/portal-actions/traceability/barcodes/create">
            <label>
                Token type
                <select name="tokenType">
                    <option value="FARMER">Farmer barcode</option>
                    <option value="PACKAGE">Input package barcode</option>
                    <option value="MANIFEST">Vehicle manifest barcode</option>
                </select>
            </label>
            <label>Entity reference <input name="entityReference" value="Demo reference" /></label>
            <button type="submit">Generate token</button>
        </form>
    </div>
</section>

<section class="workbench">
    <div class="panel large-panel">
        <div class="panel-header compact">
            <h2>Generated barcode register</h2>
            <span class="state sync">@_barcodeTokens.Count latest tokens</span>
        </div>
        <table>
            <thead><tr><th>Type</th><th>Token</th><th>Reference</th><th>Generated by</th><th>Created</th></tr></thead>
            <tbody>
                @foreach (var token in _barcodeTokens)
                {
                    <tr>
                        <td>@token.TokenType</td>
                        <td><code>@token.Token</code></td>
                        <td>@token.EntityReference</td>
                        <td>@token.GeneratedByUserId</td>
                        <td>@token.GeneratedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="panel">
        <h2>Submitted reconciliations</h2>
        <div class="check-list">
            @foreach (var row in _submittedReconciliations.Take(6))
            {
                <span>@row.CampaignName: @row.Status / @row.ReviewStatus (@row.DiscrepancyQuantity.ToString("N0"))</span>
            }
            @if (_submittedReconciliations.Count == 0)
            {
                <span>No submitted reconciliation yet.</span>
            }
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Submit stock reconciliation</h2>
            <p>Discrepancies automatically create exception cases for supervisor and audit review.</p>
        </div>
    </div>
    <form class="form-stack" method="post" action="/portal-actions/traceability/reconciliation/submit">
        <label>
            Campaign
            <select name="campaignId">
                @foreach (var campaign in _campaigns)
                {
                    <option value="@campaign.Id">@campaign.Name - @campaign.Status</option>
                }
            </select>
        </label>
        <label>Returned quantity <input name="returnedQuantity" value="0" /></label>
        <label>Supervisor user <input name="supervisorUserId" value="coordinator@agripod.local" /></label>
        <label>Notes <input name="notes" value="Reconciled at district warehouse." /></label>
        <button type="submit">Submit reconciliation</button>
    </form>
</section>

<section class="panel">
    <h2>Traceability controls covered</h2>
    <div class="check-list">
        <span>Farmer barcode token</span>
        <span>Package barcode token</span>
        <span>Manifest barcode token</span>
        <span>Loaded vs delivered vs returned stock</span>
        <span>Automatic discrepancy exception</span>
        <span>Audit log on token and reconciliation actions</span>
    </div>
</section>

@code {
    private readonly List<CampaignDto> _campaigns = [];
    private readonly List<StockReconciliationDto> _reconciliations = [];
    private readonly List<StockReconciliationDto> _submittedReconciliations = [];
    private readonly List<BarcodeTokenDto> _barcodeTokens = [];
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _message = QueryMessage();
        await Load();
    }

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        _campaigns.Clear();
        _reconciliations.Clear();
        _submittedReconciliations.Clear();
        _barcodeTokens.Clear();
        _campaigns.AddRange(await client.GetFromJsonAsync<List<CampaignDto>>("/api/v1/campaigns") ?? []);
        _submittedReconciliations.AddRange(await client.GetFromJsonAsync<List<StockReconciliationDto>>("/api/v1/traceability/reconciliations") ?? []);
        _barcodeTokens.AddRange(await client.GetFromJsonAsync<List<BarcodeTokenDto>>("/api/v1/traceability/barcodes") ?? []);
        foreach (var campaign in _campaigns.Take(8))
        {
            var row = await client.GetFromJsonAsync<StockReconciliationDto>($"/api/v1/traceability/reconciliation/{campaign.Id}?returnedQuantity=0");
            if (row is not null)
            {
                _reconciliations.Add(row);
            }
        }
    }

    private static string StatusClass(string status) => status switch
    {
        "Balanced" => "ok",
        "Discrepancy" => "danger",
        "NoDispatch" => "warn",
        _ => "sync"
    };

    private string? QueryMessage()
    {
        var query = new Uri(Navigation.Uri).Query;
        const string key = "?message=";
        return query.StartsWith(key, StringComparison.OrdinalIgnoreCase) ? Uri.UnescapeDataString(query[key.Length..]) : null;
    }
}
