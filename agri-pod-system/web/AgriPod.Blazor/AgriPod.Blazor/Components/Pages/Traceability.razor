@page "/traceability"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Obsidian Field | Integrity Ledger</PageTitle>

<div style="margin-bottom: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">Integrity Ledger</h1>
    <p style="color: var(--muted); font-weight: 700; letter-spacing: 0.1em;">Stock Reconciliation & Cryptographic Traceability Hub</p>
</div>

<div class="hud-panel" style="margin-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h2 class="hud-title" style="font-size: 1.2rem; margin: 0;">Reconciliation Watchboard</h2>
        <button @onclick="Load">Sync Vault</button>
    </div>

    <div class="tech-table-container">
        <table>
            <thead>
                <tr>
                    <th>CAMPAIGN OPERATION</th>
                    <th>LOADED</th>
                    <th>DELIVERED</th>
                    <th>DISCREPANCY</th>
                    <th style="text-align: right;">STATUS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _reconciliations)
                {
                    <tr>
                        <td style="font-weight: 900; color: var(--primary);">@row.CampaignName.ToUpper()</td>
                        <td style="font-family: 'Syncopate', sans-serif; font-size: 0.7rem;">@row.LoadedQuantity.ToString("N0")</td>
                        <td style="font-family: 'Syncopate', sans-serif; font-size: 0.7rem; color: var(--primary);">@row.DeliveredQuantity.ToString("N0")</td>
                        <td style="font-family: 'Syncopate', sans-serif; font-size: 0.7rem; color: @(row.DiscrepancyQuantity == 0 ? "var(--primary)" : "var(--accent)");">@row.DiscrepancyQuantity.ToString("N0")</td>
                        <td style="text-align: right;">
                            <span class="dot" style="color: @(row.Status == "Balanced" ? "var(--primary)" : "var(--accent)"); background: currentColor;"></span>
                            <span style="font-size: 0.7rem; font-weight: 900; color: @(row.Status == "Balanced" ? "var(--primary)" : "var(--accent)");">@row.Status.ToUpper()</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div style="display: grid; grid-template-columns: 400px 1fr; gap: 2rem; margin-bottom: 3rem;">
    <div class="hud-panel" style="background: rgba(16, 185, 129, 0.02); border-color: rgba(16, 185, 129, 0.2);">
        <h2 class="hud-title" style="font-size: 1rem; margin-bottom: 2rem; color: var(--primary);">Generate Barcode Token</h2>
        <div class="hud-input-group">
            <label>TOKEN TYPE</label>
            <select style="background: rgba(255,255,255,0.05); border: 1px solid var(--border); padding: 1rem; width: 100%; color: white;">
                <option value="FARMER">Farmer QR</option>
                <option value="PACKAGE">Input Package Barcode</option>
                <option value="MANIFEST">Manifest Barcode</option>
            </select>
        </div>
        <div class="hud-input-group">
            <label>ENTITY REFERENCE</label>
            <input value="DEMO-REF-001" />
        </div>
        <button style="width: 100%; height: 3.5rem;">Authorize Generation</button>
    </div>

    <div class="hud-panel">
        <h2 class="hud-title" style="font-size: 1rem; margin-bottom: 2rem;">Secure Token Register</h2>
        <div class="tech-table-container">
            <table>
                <thead>
                    <tr>
                        <th>TYPE</th>
                        <th>TOKEN</th>
                        <th>REFERENCE</th>
                        <th>ACTOR</th>
                        <th>CREATED</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var token in _barcodeTokens.Take(5))
                    {
                        <tr>
                            <td style="font-size: 0.6rem; font-weight: 900; color: var(--secondary);">@token.TokenType</td>
                            <td style="font-family: monospace; font-size: 0.75rem; color: var(--primary);">@token.Token</td>
                            <td style="font-weight: 700;">@token.EntityReference</td>
                            <td style="font-size: 0.65rem; color: var(--muted);">@token.GeneratedByUserId</td>
                            <td style="font-size: 0.65rem; color: var(--muted);">@token.GeneratedAt.ToString("HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="hud-panel" style="background: rgba(239, 68, 68, 0.02); border-color: rgba(239, 68, 68, 0.2);">
    <h2 class="hud-title" style="font-size: 1rem; margin-bottom: 2rem; color: var(--accent);">Final Reconciliation Report</h2>
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; align-items: flex-end;">
        <div class="hud-input-group">
            <label>CAMPAIGN NODE</label>
            <select style="background: rgba(255,255,255,0.05); border: 1px solid var(--border); padding: 1rem; width: 100%; color: white;">
                @foreach (var campaign in _campaigns) { <option value="@campaign.Id">@campaign.Name</option> }
            </select>
        </div>
        <div class="hud-input-group">
            <label>RETURNED QUANTITY</label>
            <input value="0" />
        </div>
        <button style="height: 3.5rem; border-color: var(--accent); color: var(--accent);">Submit Final Audit</button>
    </div>
</div>

@code {
    private readonly List<CampaignDto> _campaigns = [];
    private readonly List<StockReconciliationDto> _reconciliations = [];
    private readonly List<BarcodeTokenDto> _barcodeTokens = [];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        _campaigns.Clear(); _reconciliations.Clear(); _barcodeTokens.Clear();
        _campaigns.AddRange(await client.GetFromJsonAsync<List<CampaignDto>>("/api/v1/campaigns") ?? []);
        _barcodeTokens.AddRange(await client.GetFromJsonAsync<List<BarcodeTokenDto>>("/api/v1/traceability/barcodes") ?? []);
        foreach (var campaign in _campaigns.Take(5))
        {
            var row = await client.GetFromJsonAsync<StockReconciliationDto>($"/api/v1/traceability/reconciliation/{campaign.Id}?returnedQuantity=0");
            if (row is not null) _reconciliations.Add(row);
        }
    }
}
