@page "/deliveries"
@rendermode InteractiveServer
@using AgriPod.Shared
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Obsidian Field | PoD Validation</PageTitle>

<div style="margin-bottom: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 0.5rem;">Proof of Delivery</h1>
    <p style="color: var(--muted); font-weight: 700; letter-spacing: 0.1em;">Multi-Factor Authentication & Biometric Verification Ledger</p>
</div>

<div class="metric-row">
    <div class="hud-panel metric-widget" style="border-color: var(--primary);">
        <span class="metric-label">Biometric Success</span>
        <div class="metric-value">98.2%</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--primary); font-weight: 800;">FACE RECOGNITION: NOMINAL</div>
    </div>
    
    <div class="hud-panel metric-widget" style="border-color: var(--secondary);">
        <span class="metric-label">OTP Validations</span>
        <div class="metric-value" style="color: var(--secondary);">1.4k</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--secondary); font-weight: 800;">TWILIO UPLINK: STABLE</div>
    </div>

    <div class="hud-panel metric-widget" style="border-color: var(--accent);">
        <span class="metric-label">GPS Geofence Breach</span>
        <div class="metric-value" style="color: var(--accent);">04</div>
        <div style="margin-top: 1rem; font-size: 0.65rem; color: var(--accent); font-weight: 800;">ALERT: ACTION REQUIRED</div>
    </div>
</div>

<div class="hud-panel">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
        <h2 class="hud-title" style="margin: 0; font-size: 1.5rem;">Validation Stream</h2>
        <button @onclick="Load">Sync Node</button>
    </div>

    <div class="tech-table-container">
        <table>
            <thead>
                <tr>
                    <th>DELIVERY ID</th>
                    <th>RECIPIENT</th>
                    <th>SECURITY GATES</th>
                    <th>GPS COORDS</th>
                    <th>BIOMETRIC</th>
                    <th>STATUS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var delivery in _deliveries)
                {
                    <tr>
                        <td style="font-weight: 900; color: var(--primary);">@delivery.DeliveryNumber</td>
                        <td>
                            <div style="font-weight: 800;">@delivery.RecipientName</div>
                            <div style="font-size: 0.7rem; color: var(--muted);">@delivery.RecipientPhone</div>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem;">
                                <span style="font-size: 0.6rem; font-weight: 900; border: 1px solid var(--primary); padding: 0.2rem 0.4rem; color: var(--primary);">OTP</span>
                                <span style="font-size: 0.6rem; font-weight: 900; border: 1px solid var(--secondary); padding: 0.2rem 0.4rem; color: var(--secondary);">FACE</span>
                                <span style="font-size: 0.6rem; font-weight: 900; border: 1px solid var(--accent); padding: 0.2rem 0.4rem; color: var(--accent);">GPS</span>
                            </div>
                        </td>
                        <td style="font-family: monospace; font-size: 0.75rem; color: var(--muted);">8.48N, 11.75W</td>
                        <td style="font-weight: 800; color: var(--primary);">94% MATCH</td>
                        <td>
                            <span class="dot" style="color: @(delivery.Status == "Delivered" ? "var(--primary)" : "var(--accent)"); background: currentColor;"></span>
                            <span style="font-size: 0.7rem; font-weight: 900; color: @(delivery.Status == "Delivered" ? "var(--primary)" : "var(--accent)");">@delivery.Status.ToUpper()</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private readonly List<DeliveryDto> _deliveries = [];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var client = HttpClientFactory.CreateClient("AgriPodApi");
        _deliveries.Clear();
        _deliveries.AddRange(await client.GetFromJsonAsync<List<DeliveryDto>>("/api/v1/deliveries") ?? []);
    }
}
